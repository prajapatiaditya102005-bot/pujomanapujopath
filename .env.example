# Pujo Mana PujoPath — Environment Configuration Example
# Official Tagline: "Celebrate Maa Durga. Explore Kolkata. Get Stuck Less."

# Application Environment
VITE_APP_NAME="Pujo Mana PujoPath"
VITE_APP_TAGLINE="Celebrate Maa Durga. Explore Kolkata. Get Stuck Less."
VITE_APP_ENV="production"
VITE_PORT=3000

# OpenStreetMap & Tile Provider Settings
# Leaflet by default uses OpenStreetMap tiles with no required API key
VITE_OSM_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
VITE_OSM_ATTRIBUTION="&copy; OpenStreetMap contributors | Pujo Mana PujoPath"

# Optional OSRM Routing Engine Endpoint (falls back to client-side distance matrix & routing)
# VITE_OSRM_API_URL="https://router.project-osrm.org/route/v1"

# Geocoding & Emergency Contacts
VITE_KOLKATA_POLICE_HELPLINE="100"
VITE_TRAFFIC_POLICE_HELPLINE="1073"
VITE_MEDICAL_AMBULANCE_HELPLINE="108"
VITE_WOMEN_HELPLINE="1091"
